<?xml version="1.0" ?>
<!--
  Crop-field world for the Task2 AI Rover.
  Layout:
    • 30 × 30 m grass-colored ground plane
    • 6 parallel rows of "corn" (thin tall green cylinders), 8 plants per row
    • Row spacing 1.2 m so the rover (≈0.21 m wide) has clear lanes
    • A few small boxes near spawn so the 2 m sonars see something close
    • Sun + ambient light
  Spawn the rover at (0, 0, 0.15); rows run along +X starting at X=1.5 m.
-->
<sdf version="1.8">
  <world name="rover_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"        name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"  name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <!-- Sensors plugin lives at WORLD level (not model level) so 3–10 rovers
         share one rendering pipeline instead of instantiating N competing ones. -->
    <!-- IMU is not a render sensor; it needs its own system or /rover_N/imu
         never publishes (found 2026-07-16 during Swarm-SLAM integration). -->
    <plugin filename="ignition-gazebo-imu-system" name="ignition::gazebo::systems::Imu"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 -0.4 -0.9</direction>
    </light>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <grid>false</grid>
    </scene>

    <!-- GRASS GROUND -->
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.20 0.55 0.18 1</ambient>
            <diffuse>0.25 0.65 0.22 1</diffuse>
            <specular>0.05 0.1 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Small boxes near spawn so the 2 m sonars register something -->
    <model name="box_near_left">
      <static>true</static>
      <pose>0.6 0.7 0.1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.75 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_near_right">
      <static>true</static>
      <pose>0.6 -0.7 0.1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.75 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="box_behind">
      <static>true</static>
      <pose>-0.8 0.0 0.1 0 0 0</pose>
      <link name="l">
        <collision name="c"><geometry><box><size>0.2 0.2 0.2</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.2 0.2 0.2</size></box></geometry>
          <material><ambient>0.7 0.4 0.2 1</ambient><diffuse>0.75 0.45 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         CROP ROWS — 6 rows × 8 plants
         Each plant: 0.05 m radius cylinder, 1.2 m tall (visible to lidar at any pitch)
         Rows along +X, lane spacing 1.2 m in Y
    ═══════════════════════════════════════════════════ -->

    <!-- Row Y=-3.0 -->
    <model name="crop_r1_p1"><static>true</static><pose>1.5 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r1_p2"><static>true</static><pose>2.7 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r1_p3"><static>true</static><pose>3.9 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r1_p4"><static>true</static><pose>5.1 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r1_p5"><static>true</static><pose>6.3 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r1_p6"><static>true</static><pose>7.5 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r1_p7"><static>true</static><pose>8.7 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r1_p8"><static>true</static><pose>9.9 -3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>

    <!-- Row Y=-1.8 -->
    <model name="crop_r2_p1"><static>true</static><pose>1.5 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r2_p2"><static>true</static><pose>2.7 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r2_p3"><static>true</static><pose>3.9 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r2_p4"><static>true</static><pose>5.1 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r2_p5"><static>true</static><pose>6.3 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r2_p6"><static>true</static><pose>7.5 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r2_p7"><static>true</static><pose>8.7 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r2_p8"><static>true</static><pose>9.9 -1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>

    <!-- Row Y=1.8 -->
    <model name="crop_r3_p1"><static>true</static><pose>1.5 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r3_p2"><static>true</static><pose>2.7 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r3_p3"><static>true</static><pose>3.9 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r3_p4"><static>true</static><pose>5.1 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r3_p5"><static>true</static><pose>6.3 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r3_p6"><static>true</static><pose>7.5 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r3_p7"><static>true</static><pose>8.7 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r3_p8"><static>true</static><pose>9.9 1.8 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>

    <!-- Row Y=3.0 -->
    <model name="crop_r4_p1"><static>true</static><pose>1.5 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r4_p2"><static>true</static><pose>2.7 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r4_p3"><static>true</static><pose>3.9 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r4_p4"><static>true</static><pose>5.1 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r4_p5"><static>true</static><pose>6.3 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r4_p6"><static>true</static><pose>7.5 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r4_p7"><static>true</static><pose>8.7 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>
    <model name="crop_r4_p8"><static>true</static><pose>9.9 3.0 0.6 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.05</radius><length>1.2</length></cylinder></geometry><material><ambient>0.1 0.55 0.1 1</ambient><diffuse>0.15 0.65 0.15 1</diffuse></material></visual></link></model>

    <!-- Charging / docking station (Clearpath-Jackal inspired: V-funnel + AprilTag + reverse-in pogo pins).
         Placed at (-2.0, 0) with mouth opening toward +X — rovers spawn at x=0 and reverse (-X) to dock.
         Footprint: base pad 0.32 x 0.30 m. Throat 0.12 m, mouth 0.28 m (funnel absorbs ~8 cm lateral error).
         All parts under one <model> so it moves as a unit if user relocates it. -->
    <model name="charging_station_0">
      <static>true</static>
      <pose>-2.0 0 0 0 0 0</pose>
      <link name="base">
        <!-- Ground pad (dark gray slab so the station reads as a docking bay) -->
        <visual name="pad_v"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.32 0.30 0.01</size></box></geometry><material><ambient>0.15 0.15 0.17 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse></material></visual>
        <collision name="pad_c"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.32 0.30 0.01</size></box></geometry></collision>

        <!-- Back plate: 25 cm wide, 8 cm tall, 2 cm thick, at back (x=-0.15) -->
        <visual name="back_v"><pose>-0.15 0 0.04 0 0 0</pose><geometry><box><size>0.02 0.25 0.08</size></box></geometry><material><ambient>0.35 0.35 0.38 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material></visual>
        <collision name="back_c"><pose>-0.15 0 0.04 0 0 0</pose><geometry><box><size>0.02 0.25 0.08</size></box></geometry></collision>

        <!-- Left funnel wall: opens from throat (y=+0.06 at x=-0.15) to mouth (y=+0.14 at x=+0.15).
             Midpoint (0, 0.10, 0.04), length 0.31 m, yaw = atan2(0.08, 0.30) ≈ 0.2606 rad ≈ 14.9°. -->
        <visual name="wall_L_v"><pose>0 0.10 0.04 0 0 0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry><material><ambient>0.55 0.45 0.10 1</ambient><diffuse>0.75 0.60 0.15 1</diffuse></material></visual>
        <collision name="wall_L_c"><pose>0 0.10 0.04 0 0 0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry></collision>

        <!-- Right funnel wall: mirror of the left. -->
        <visual name="wall_R_v"><pose>0 -0.10 0.04 0 0 -0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry><material><ambient>0.55 0.45 0.10 1</ambient><diffuse>0.75 0.60 0.15 1</diffuse></material></visual>
        <collision name="wall_R_c"><pose>0 -0.10 0.04 0 0 -0.2606</pose><geometry><box><size>0.31 0.015 0.08</size></box></geometry></collision>

        <!-- Two pogo-pin contacts on back plate at wheel-clearance height (0.03 m). Cylinders oriented along X.
             Copper color so they read as electrical contacts. -->
        <visual name="pin_L_v"><pose>-0.135 0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry><material><ambient>0.55 0.30 0.10 1</ambient><diffuse>0.80 0.45 0.15 1</diffuse></material></visual>
        <collision name="pin_L_c"><pose>-0.135 0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry></collision>
        <visual name="pin_R_v"><pose>-0.135 -0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry><material><ambient>0.55 0.30 0.10 1</ambient><diffuse>0.80 0.45 0.15 1</diffuse></material></visual>
        <collision name="pin_R_c"><pose>-0.135 -0.03 0.03 0 1.5708 0</pose><geometry><cylinder><radius>0.008</radius><length>0.02</length></cylinder></geometry></collision>

        <!-- AprilTag mast: rises 15 cm above back plate; front-facing plate for the tag texture.
             White plate now — swap material for a real AprilTag PNG when the visual servo node comes online. -->
        <visual name="mast_v"><pose>-0.15 0 0.15 0 0 0</pose><geometry><box><size>0.02 0.10 0.14</size></box></geometry><material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material></visual>
        <collision name="mast_c"><pose>-0.15 0 0.15 0 0 0</pose><geometry><box><size>0.02 0.10 0.14</size></box></geometry></collision>
        <visual name="tag_v"><pose>-0.139 0 0.20 0 0 0</pose><geometry><box><size>0.002 0.06 0.06</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>

        <!-- Status LED beacon (small green cylinder atop mast — visible cue that dock is "live") -->
        <visual name="led_v"><pose>-0.15 0 0.235 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.015</length></cylinder></geometry><material><ambient>0.1 0.6 0.1 1</ambient><diffuse>0.2 0.9 0.2 1</diffuse><emissive>0.1 0.5 0.1 1</emissive></material></visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════
         PERIMETER LANDMARKS — added 2026-07-23 for Swarm-SLAM
         ═══════════════════════════════════════════════════
         Problem they solve: the crop grid is perfectly periodic (4 identical
         rows, 8 identical 1.2 m cylinders at exact 1.2 m spacing), so every
         position in a lane produces a near-identical lidar scan. Scancontext
         place recognition could not distinguish locations: a 3-rover run
         measured a CONTINUOUS ICP-inlier distribution from 7 to 35 for FAILED
         matches, i.e. no inlier threshold separates true from false loop
         closures. Raising loop-closure volume then made the merged map WORSE
         (inter-robot baseline error 0.6-1.4 m -> 2.2-3.2 m; a parked rover_1
         was warped 6 m by false constraints).

         Design rules (keep these if adding more):
           1. TALLER than the 1.2 m corn (here 1.5-3.2 m) so they are visible
              over the rows from anywhere in the field, not just down a lane.
              Scancontext bins MAX HEIGHT per polar cell, so height variety is
              the single strongest discriminator available.
           2. Every landmark a DIFFERENT height/shape/radius, so the set of
              (range, azimuth, height) triples seen from any given spot is
              unique -> distinct descriptor per location.
           3. Positions deliberately NOT multiples of 1.2 m, to break the grid
              periodicity that causes row-aliasing.
           4. All placed OUTSIDE the drivable area (crop rect x 1.5..9.9,
              y -3.0..3.0, plus the origin staging area and charging station),
              so they can never be collided with. Rovers have crashed into
              in-field obstacles before; keep the lanes clear.
    ═══════════════════════════════════════════════════ -->

    <!-- South edge -->
    <model name="lm_s1"><static>true</static><pose>0.7 -4.0 1.30 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.18</radius><length>2.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.18</radius><length>2.6</length></cylinder></geometry><material><ambient>0.45 0.25 0.15 1</ambient><diffuse>0.65 0.35 0.20 1</diffuse></material></visual></link></model>
    <model name="lm_s2"><static>true</static><pose>3.4 -4.5 0.85 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.9 0.9 1.7</size></box></geometry></collision><visual name="v"><geometry><box><size>0.9 0.9 1.7</size></box></geometry><material><ambient>0.30 0.30 0.35 1</ambient><diffuse>0.45 0.45 0.52 1</diffuse></material></visual></link></model>
    <model name="lm_s3"><static>true</static><pose>6.1 -4.0 0.80 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.40</radius><length>1.6</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.40</radius><length>1.6</length></cylinder></geometry><material><ambient>0.50 0.45 0.15 1</ambient><diffuse>0.72 0.62 0.20 1</diffuse></material></visual></link></model>
    <model name="lm_s4"><static>true</static><pose>9.2 -4.4 1.45 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>0.5 1.6 2.9</size></box></geometry></collision><visual name="v"><geometry><box><size>0.5 1.6 2.9</size></box></geometry><material><ambient>0.40 0.15 0.15 1</ambient><diffuse>0.60 0.22 0.22 1</diffuse></material></visual></link></model>

    <!-- East edge -->
    <model name="lm_e1"><static>true</static><pose>11.2 -2.2 1.10 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.2</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.2</length></cylinder></geometry><material><ambient>0.20 0.35 0.45 1</ambient><diffuse>0.30 0.52 0.66 1</diffuse></material></visual></link></model>
