    <model name="lm_e3"><static>true</static><pose>11.1 2.8 0.90 0 0 0</pose><link name="l"><collision name="c"><geometry><cylinder><radius>0.15</radius><length>1.8</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>0.15</radius><length>1.8</length></cylinder></geometry><material><ambient>0.45 0.30 0.10 1</ambient><diffuse>0.68 0.45 0.15 1</diffuse></material></visual></link></model>

